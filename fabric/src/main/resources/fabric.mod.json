{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/iamkaf/ender-sight",
        "issues": "https://github.com/iamkaf/mod-issues/issues",
        "sources": "https://github.com/iamkaf/ender-sight"
    },
    "license": "${license}",
    "icon": "icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.iamkaf.endersight.EnderSightFabric"
        ]
    },
    "accessWidener": "${mod_id}.accesswidener",
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "amber": ">=${amber_version}",
        "minecraft": "${fabric_version_range}",
        "java": ">=${java_version}"
    }
}
